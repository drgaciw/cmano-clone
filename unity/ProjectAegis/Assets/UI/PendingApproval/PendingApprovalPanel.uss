/* DRG-66 / DRG-182 — pending approval queue with authority context row. */

.c2-pending-approval {
    flex-grow: 1;
    min-width: 280px;
    max-width: 420px;
    padding: 8px;
    background-color: rgba(12, 18, 28, 0.94);
    border-width: 1px;
    border-color: rgb(80, 100, 120);
    flex-direction: column;
}

.c2-pending-approval-header {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(220, 230, 240);
}

.c2-pending-approval-badge {
    font-size: 11px;
    color: rgb(180, 195, 210);
    margin-bottom: 4px;
}

.c2-pending-approval-empty {
    font-size: 11px;
    color: rgb(160, 175, 190);
    margin-bottom: 4px;
}

.c2-pending-approval-list {
    flex-grow: 1;
    min-height: 80px;
    max-height: 200px;
}

.c2-pending-approval-authority {
    font-size: 10px;
    color: rgb(190, 205, 170);
    white-space: normal;
    margin-top: 4px;
    margin-bottom: 4px;
}

.c2-pending-approval-actions {
    flex-direction: row;
    margin-top: 6px;
}

.c2-pending-approval-approve,
.c2-pending-approval-reject {
    flex-grow: 1;
    margin-right: 6px;
    font-size: 11px;
}

.c2-pending-approval-status {
    font-size: 10px;
    color: rgb(220, 120, 120);
    margin-top: 4px;
}
