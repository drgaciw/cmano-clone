<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="osint-staging-root" class="osint-staging-panel">
        <ui:Label text="OSINT STAGING REVIEW" class="osint-staging-title" />
        <ui:Label name="status-line" text="OSINT Staging: ready" class="osint-staging-status" />
        <ui:Label text="PROPOSALS (&gt;= 0.65)" class="osint-staging-section-header" />
        <ui:ListView name="proposal-list" class="osint-staging-list" selection-type="Single" />
        <ui:VisualElement name="osint-detail-card" class="osint-detail-card">
            <ui:Label name="osint-detail-title" text="No proposal selected" class="osint-detail-title" />
            <ui:Label name="osint-detail-confidence" text="CONFIDENCE: —" class="osint-detail-confidence" />
            <ui:Label name="osint-detail-trl" text="TRL —" class="osint-detail-trl" />
            <ui:Label name="osint-detail-citation-url" text="CITATION: —" class="osint-detail-citation-url" />
            <ui:Label name="osint-detail-citation-snippet" text="SNIPPET: —" class="osint-detail-citation-snippet" />
        </ui:VisualElement>
        <ui:VisualElement name="osint-actions" class="osint-actions">
            <ui:Button name="refresh-button" text="Refresh" class="osint-action-button" />
            <ui:Button name="approve-selected" text="Approve" class="osint-action-button osint-approve-button" />
            <ui:Button name="reject-selected" text="Reject" class="osint-action-button osint-reject-button" />
        </ui:VisualElement>
        <ui:VisualElement name="osint-logonly-section" class="osint-logonly-section">
            <ui:Label text="LOG-ONLY (&lt; 0.65 — read-only)" class="osint-staging-section-header" />
            <ui:ListView name="logonly-list" class="osint-logonly-list" selection-type="Single" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
