@import url("../AegisTokens.uss");

.oob-tree-panel {
    flex-grow: 1;
    min-width: 220px;
    padding: 6px;
    background-color: rgba(12, 18, 28, 0.92);
}

.oob-tree-title {
    -unity-font-style: bold;
    color: rgb(200, 210, 220);
    margin-bottom: 4px;
}

.oob-tree-list {
    flex-grow: 1;
}

.oob-row {
    padding: 2px 4px;
    color: rgb(180, 190, 200);
}

.oob-row--selected {
    background-color: rgba(74, 158, 255, 0.25);
    border-left-width: 3px;
    border-left-color: rgb(74, 158, 255);
}

.oob-row--dead {
    color: var(--text-muted);
    opacity: 0.55;
}

/* Controller badge on the row (DRG-374). Colour is the right edge; shape is the border. */
.oob-controller-badge {
    padding-right: 6px;
}

.oob-row.badge-human {
    border-right-width: 3px;
    border-right-color: rgb(74, 158, 255);
}

.oob-row.badge-agent {
    border-right-width: 3px;
    border-right-color: rgb(230, 170, 40);
}

.oob-row.badge-agent-suspended {
    border-right-width: 3px;
    border-right-color: rgb(230, 200, 80);
}

.oob-row.badge-shape-square {
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgb(140, 155, 170);
    border-bottom-color: rgb(140, 155, 170);
    border-radius: 0;
}

.oob-row.badge-shape-diamond {
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 4px;
    border-right-width: 4px;
    border-radius: 0;
}

.oob-row.badge-shape-diamond-dashed {
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 3px;
    border-right-width: 3px;
    -unity-font-style: italic;
}

/* Keyboard discovery baseline (DRG-270) — Tab reaches OOB list rows. */
.oob-row:focus {
    border-left-width: var(--focus-ring-width);
    border-left-color: var(--focus-ring);
}
