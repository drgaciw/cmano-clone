<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="c2-topbar-root" class="c2-topbar">
        <ui:VisualElement name="c2-topbar-status-row" class="c2-topbar-status-row">
            <ui:Label name="sim-time-label" text="SIM 00:00:00" class="c2-topbar-item" />
            <ui:Label name="zulu-time-label" text="ZULU 00:00:00" class="c2-topbar-item c2-topbar-item--time" />
            <ui:Label name="local-time-label" text="LOCAL 00:00:00" class="c2-topbar-item c2-topbar-item--time" />
            <ui:Label name="remaining-duration-label" text="REMAIN —" class="c2-topbar-item c2-topbar-item--time" />
            <ui:Label name="phase-label" text="PHASE: Planning" class="c2-topbar-item" />
            <ui:Button name="begin-execution-button" text="Begin Execution" class="c2-topbar-begin-execution" />
            <ui:VisualElement name="compression-cluster" class="c2-topbar-compression">
                <ui:Button name="compression-slower-button" text="−" class="c2-topbar-compression-btn" />
                <ui:Label name="compression-label" text="TIME: 1x" class="c2-topbar-item c2-topbar-item--compression" />
                <ui:Button name="compression-faster-button" text="+" class="c2-topbar-compression-btn" />
                <ui:Button name="pause-resume-button" text="PAUSE" class="c2-topbar-pause" />
            </ui:VisualElement>
            <ui:Label name="mode-label" text="MODE: —" class="c2-topbar-item" />
            <ui:Label name="fog-mode-label" text="FOG: —" class="c2-topbar-item c2-topbar-item--fog" />
            <ui:Label name="comms-label" text="COMMS: NOMINAL" class="c2-topbar-item c2-topbar-item--comms" />
            <ui:Label name="score-label" text="SCORE: 0" class="c2-topbar-item c2-topbar-item--score" />
        </ui:VisualElement>
        <ui:VisualElement name="c2-topbar-comms-legend" class="c2-topbar-comms-legend">
            <ui:Label text="COMMS LEGEND:" class="c2-topbar-legend-title" />
            <ui:Label text="NOMINAL = full picture" class="c2-topbar-legend-item c2-topbar-legend-item--nominal" />
            <ui:Label text="DEGRADED = stale contacts, reduced symbol opacity" class="c2-topbar-legend-item c2-topbar-legend-item--degraded" />
            <ui:Label text="DENIED = no new engagements, map dimmed" class="c2-topbar-legend-item c2-topbar-legend-item--denied" />
            <ui:Label name="comms-network-advisory-badge" text="" class="c2-topbar-legend-item c2-topbar-legend-item--network-advisory" />
            <ui:Label name="comms-network-health-label" text="Network: —" class="c2-topbar-legend-item c2-topbar-legend-item--network" />
            <ui:Label name="comms-network-node-label" text="" class="c2-topbar-legend-item c2-topbar-legend-item--network-node" />
            <ui:Label name="comms-network-detail-label" text="" class="c2-topbar-legend-item c2-topbar-legend-item--network-detail" />
            <ui:Label name="comms-network-contributors-label" text="" class="c2-topbar-legend-item c2-topbar-legend-item--network-contributors" />
            <ui:Label name="comms-network-lost-paths-label" text="" class="c2-topbar-legend-item c2-topbar-legend-item--network-lost-paths" />
            <ui:Label name="comms-network-next-label" text="" class="c2-topbar-legend-item c2-topbar-legend-item--network-next" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
