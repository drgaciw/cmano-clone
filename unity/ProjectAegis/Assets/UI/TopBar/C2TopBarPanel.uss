/* C2 top bar chrome — absolute strip across the top of the Game view. */

.c2-topbar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    min-height: 52px;
    flex-direction: column;
    flex-shrink: 0;
    padding: 6px 12px;
    background-color: rgba(10, 16, 26, 0.95);
    border-bottom-width: 1px;
    border-bottom-color: rgb(50, 65, 80);
}

.c2-topbar-status-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.c2-topbar-comms-legend {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 2px;
    padding-top: 2px;
    border-top-width: 1px;
    border-top-color: rgba(50, 65, 80, 0.6);
}

.c2-topbar-legend-title {
    margin-right: 8px;
    color: rgb(140, 155, 170);
    font-size: 10px;
    -unity-font-style: bold;
}

.c2-topbar-legend-item {
    margin-right: 12px;
    font-size: 10px;
    color: rgb(170, 180, 190);
}

.c2-topbar-legend-item--nominal {
    color: rgb(100, 200, 140);
}

.c2-topbar-legend-item--degraded {
    color: rgb(240, 180, 80);
}

.c2-topbar-legend-item--denied {
    color: rgb(230, 90, 90);
}

.c2-topbar-item {
    margin-right: 16px;
    color: rgb(190, 200, 210);
    font-size: 12px;
}

/* CMD-22: compact Zulu / local / remaining clocks */
.c2-topbar-item--time {
    margin-right: 12px;
    font-size: 11px;
    color: rgb(160, 175, 190);
    -unity-font-style: normal;
    letter-spacing: 0.5px;
}

.c2-topbar-item--comms {
    -unity-font-style: bold;
}

.c2-topbar-item--comms-nominal {
    color: rgb(100, 200, 140);
}

.c2-topbar-item--comms-degraded {
    color: rgb(240, 180, 80);
}

.c2-topbar-item--comms-denied {
    color: rgb(230, 90, 90);
}

.c2-topbar-compression {
    flex-direction: row;
    align-items: center;
    margin-right: 12px;
}

.c2-topbar-item--compression {
    margin-right: 8px;
    min-width: 88px;
}

.c2-topbar-compression-btn {
    margin-right: 4px;
    padding: 1px 8px;
    background-color: rgb(32, 44, 58);
    border-width: 1px;
    border-color: rgb(80, 100, 120);
    color: rgb(210, 220, 230);
    font-size: 12px;
    -unity-font-style: bold;
}

.c2-topbar-pause {
    margin-right: 8px;
    padding: 2px 10px;
    background-color: rgb(70, 40, 40);
    border-width: 1px;
    border-color: rgb(160, 80, 80);
    color: rgb(240, 220, 220);
    font-size: 11px;
    -unity-font-style: bold;
}

.c2-topbar-begin-execution {
    margin-right: 16px;
    padding: 2px 10px;
    background-color: rgb(40, 90, 60);
    border-width: 1px;
    border-color: rgb(80, 160, 100);
    color: rgb(220, 240, 220);
    font-size: 12px;
    -unity-font-style: bold;
}

.c2-topbar-item--score {
    margin-left: auto;
    -unity-font-style: bold;
    color: rgb(240, 192, 64);
}
