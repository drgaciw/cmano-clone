.mission-list-panel {
    flex-grow: 1;
    min-width: 220px;
    padding: 6px;
    background-color: rgba(12, 18, 28, 0.92);
}

.mission-list-title {
    -unity-font-style: bold;
    color: rgb(200, 210, 220);
    margin-bottom: 4px;
}

.mission-list-subtitle {
    -unity-font-style: bold;
    color: rgb(180, 190, 205);
    margin-top: 6px;
    margin-bottom: 2px;
}

.mission-list-line {
    color: rgb(190, 200, 215);
    margin-bottom: 2px;
}

.mission-list-view {
    flex-grow: 1;
    min-height: 80px;
}

.mission-list-package-view {
    min-height: 56px;
    max-height: 120px;
    margin-bottom: 4px;
}

.mission-list-next {
    color: rgb(170, 180, 195);
    white-space: normal;
}
