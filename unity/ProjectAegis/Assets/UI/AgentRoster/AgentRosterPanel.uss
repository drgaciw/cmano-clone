/* Agent roster + directive issuance surface (CMD-37). */

.agent-roster-panel {
    flex-grow: 1;
    min-width: 240px;
    max-width: 360px;
    padding: 6px;
    background-color: rgba(12, 18, 28, 0.92);
    border-width: 1px;
    border-color: rgb(50, 65, 80);
}

.agent-roster-title {
    -unity-font-style: bold;
    color: rgb(200, 210, 220);
    margin-bottom: 4px;
    font-size: 12px;
}

.agent-roster-list {
    flex-grow: 1;
    min-height: 80px;
    max-height: 220px;
    margin-bottom: 6px;
}

.agent-roster-row {
    flex-direction: row;
    align-items: center;
}

.agent-roster-line {
    flex-grow: 1;
    white-space: normal;
}

/* Controller badge chip (DRG-375). Shape and colour are separate channels. */
.agent-roster-badge {
    margin-right: 6px;
    padding: 0 4px;
    font-size: 11px;
    -unity-font-style: bold;
    white-space: nowrap;
}

.badge-human {
    color: rgb(16, 24, 36);
    background-color: rgb(186, 214, 255);
    border-color: rgb(74, 158, 255);
}

.badge-agent {
    color: rgb(28, 22, 8);
    background-color: rgb(255, 214, 120);
    border-color: rgb(230, 170, 40);
}

.badge-agent-suspended {
    color: rgb(230, 200, 80);
    background-color: rgba(40, 32, 12, 0.92);
    border-color: rgb(230, 200, 80);
}

.badge-none {
    color: rgb(160, 170, 180);
    background-color: rgba(20, 26, 34, 0.92);
    border-color: rgb(90, 100, 112);
}

.badge-shape-square {
    border-width: 1px;
    border-radius: 0;
}

.badge-shape-diamond {
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 5px;
    border-right-width: 5px;
    border-radius: 0;
}

.badge-shape-diamond-dashed {
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 4px;
    border-right-width: 4px;
    border-radius: 0;
    -unity-font-style: bold-and-italic;
}

.badge-shape-none {
    border-width: 1px;
    border-radius: 2px;
}

.agent-directive-buttons {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 4px;
}

.agent-directive-btn {
    margin-right: 6px;
    margin-bottom: 4px;
    padding: 4px 10px;
    background-color: rgb(32, 48, 68);
    border-width: 1px;
    border-color: rgb(70, 95, 120);
    color: rgb(210, 220, 230);
    font-size: 11px;
}

.agent-directive-btn:hover {
    background-color: rgb(42, 62, 88);
}

.agent-directive-btn:disabled {
    opacity: 0.45;
}

.agent-directive-status {
    margin-top: 2px;
    color: rgb(240, 180, 80);
    font-size: 11px;
    min-height: 14px;
}
