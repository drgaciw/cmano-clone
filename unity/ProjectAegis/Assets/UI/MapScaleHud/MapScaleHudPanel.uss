/* UAT D17 — map scale bar and camera altitude readout (CMD-20). Presentation only. */

.c2-map-scale-hud {
    min-width: 160px;
    max-width: 260px;
    padding: 6px;
    background-color: rgba(12, 18, 28, 0.88);
    border-width: 1px;
    border-color: rgb(80, 100, 120);
    flex-direction: column;
}

.c2-map-scale-hud-bar {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(220, 230, 240);
}

.c2-map-scale-hud-altitude {
    font-size: 10px;
    color: rgb(160, 175, 190);
}
