/* UAT D17 — ground formations / ADA / facility summary (CMD-26 Phase A). Presentation only. */

.c2-ground-ops {
    flex-grow: 1;
    min-width: 280px;
    max-width: 420px;
    padding: 8px;
    background-color: rgba(12, 18, 28, 0.94);
    border-width: 1px;
    border-color: rgb(80, 100, 120);
    flex-direction: column;
}

.c2-ground-ops-header {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(220, 230, 240);
    margin-bottom: 4px;
}

.c2-ground-ops-empty {
    font-size: 11px;
    color: rgb(160, 175, 190);
    margin-bottom: 4px;
}

.c2-ground-ops-list {
    flex-grow: 1;
    min-height: 80px;
    max-height: 240px;
}
