/* Sensor-to-shooter chain chrome — text labels only (DRG-181). */

.sensor-to-shooter-panel {
    position: absolute;
    right: 0;
    top: 52%;
    bottom: 0;
    width: 300px;
    min-width: 260px;
    flex-direction: column;
    padding: 8px;
    background-color: rgba(14, 18, 24, 0.94);
    border-left-width: 1px;
    border-left-color: rgb(70, 90, 110);
}

.sensor-to-shooter-title {
    -unity-font-style: bold;
    color: rgb(180, 200, 220);
    margin-bottom: 6px;
}

.sensor-to-shooter-line {
    color: rgb(175, 185, 195);
    margin-bottom: 2px;
}

.sensor-to-shooter-line--link {
    -unity-font-style: italic;
}
