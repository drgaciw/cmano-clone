/* Magazine loadout depth panel (CMD-24 / REQ-20). */

.magazine-loadout-panel {
    flex-grow: 1;
    min-width: 260px;
    max-width: 400px;
    padding: 6px;
    background-color: rgba(12, 20, 28, 0.92);
    border-width: 1px;
    border-color: rgb(55, 80, 100);
}

.magazine-loadout-title {
    -unity-font-style: bold;
    color: rgb(180, 210, 230);
    margin-bottom: 4px;
    font-size: 12px;
}

.magazine-loadout-empty {
    color: rgb(240, 180, 80);
    font-size: 11px;
    min-height: 14px;
    margin-bottom: 4px;
}

.magazine-loadout-list {
    flex-grow: 1;
    min-height: 80px;
    max-height: 240px;
}

.magazine-loadout-feasibility {
    color: rgb(160, 200, 170);
    font-size: 10px;
    min-height: 12px;
    margin-top: 4px;
}
