/* DRG-67 / DRG-182 / DRG-265 — engage explain with authority and domain abort codes. */

.c2-engage-explain {
    flex-grow: 1;
    min-width: 280px;
    max-width: 440px;
    padding: 8px;
    background-color: rgba(14, 20, 30, 0.94);
    border-width: 1px;
    border-color: rgb(90, 70, 70);
    flex-direction: column;
}

.c2-engage-explain-status {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(230, 200, 180);
    margin-bottom: 4px;
}

.c2-engage-explain-authority {
    font-size: 10px;
    color: rgb(190, 205, 170);
    white-space: normal;
    margin-bottom: 6px;
}

.c2-engage-explain-reason {
    font-size: 11px;
    color: rgb(200, 210, 220);
    white-space: normal;
}

.engage-explain-domain-abort {
    font-size: 11px;
    color: rgb(220, 210, 190);
    white-space: normal;
    margin-bottom: 4px;
    -unity-font-style: bold;
}

.domain-abort-cue--unknown {
    border-left-width: 3px;
    border-left-color: rgb(130, 130, 140);
    padding-left: 6px;
    -unity-font-style: italic;
}

.domain-abort-cue--clear {
    border-left-width: 3px;
    border-left-color: rgb(110, 150, 120);
    padding-left: 6px;
}

.domain-abort-cue--blocked {
    border-left-width: 3px;
    border-left-color: rgb(170, 100, 100);
    padding-left: 6px;
    -unity-font-style: bold;
}
