.jev-attention-panel {
    flex-direction: column;
    padding: 8px 12px;
    background-color: rgba(10, 16, 26, 0.92);
    border-width: 1px;
    border-color: rgb(50, 65, 80);
}

.jev-model-pin {
    margin-bottom: 4px;
    font-size: 10px;
    color: rgb(140, 155, 170);
}

.jev-disclosure--visible {
    margin-bottom: 6px;
    padding: 4px 8px;
    color: rgb(240, 180, 80);
    background-color: rgba(80, 50, 20, 0.85);
    -unity-font-style: bold;
    white-space: normal;
}

.jev-disclosure--hidden {
    display: none;
}

.jev-attention-list {
    flex-direction: column;
}

.jev-attention-row {
    margin-bottom: 2px;
    font-size: 12px;
    color: rgb(190, 200, 210);
}

.jev-attention-row--immediate {
    color: rgb(230, 90, 90);
    -unity-font-style: bold;
}

.jev-attention-row--focus {
    color: rgb(240, 180, 80);
    -unity-font-style: bold;
}

.jev-attention-row--watch {
    color: rgb(120, 200, 255);
}

.jev-attention-row--low {
    color: rgb(160, 175, 190);
}

.jev-attention-row--ignore {
    color: rgb(110, 120, 130);
}

.jev-attention-row--unavailable {
    color: rgb(140, 155, 170);
    -unity-font-style: italic;
}
