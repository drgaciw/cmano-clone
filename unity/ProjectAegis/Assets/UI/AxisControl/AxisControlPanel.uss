/* UAT D17 — axis control readout (altitude / throttle / EMCON / sensors). Presentation only. */

.c2-axis-control {
    min-width: 200px;
    max-width: 320px;
    padding: 8px;
    background-color: rgba(12, 18, 28, 0.94);
    border-width: 1px;
    border-color: rgb(80, 100, 120);
    flex-direction: column;
}

.c2-axis-control-badge {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(220, 230, 240);
    margin-bottom: 4px;
}

.c2-axis-control-axis {
    font-size: 11px;
    color: rgb(180, 195, 210);
}
