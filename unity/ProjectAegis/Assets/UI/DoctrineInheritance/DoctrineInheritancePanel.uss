/* Doctrine panel — docks under the right unit column when enabled. */

@import url("../AegisTokens.uss");

.doctrine-panel {
    position: absolute;
    right: 8px;
    bottom: 236px;
    width: 284px;
    min-width: 260px;
    max-height: 40%;
    flex-direction: column;
    padding: 8px;
    background-color: rgba(12, 18, 28, 0.94);
    border-width: 1px;
    border-color: rgb(50, 65, 80);
    border-radius: 4px;
}

.doctrine-title {
    -unity-font-style: bold;
    color: rgb(200, 210, 220);
    margin-bottom: 4px;
}

.doctrine-inheritance-order {
    color: rgb(140, 155, 170);
    font-size: 11px;
    margin-bottom: 6px;
    white-space: normal;
}

.doctrine-line {
    color: rgb(180, 190, 200);
    margin-bottom: 2px;
}

.doctrine-line--roe {
    -unity-font-style: bold;
}

.doctrine-line--wra {
    color: rgb(170, 185, 200);
}

.doctrine-line--emcon {
    color: rgb(160, 175, 190);
}

.doctrine-line--override {
    color: rgb(240, 180, 80);
}

.doctrine-override-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 4px;
    margin-bottom: 4px;
}

.doctrine-dropdown {
    min-width: 160px;
    margin-right: 8px;
    margin-bottom: 4px;
}

.doctrine-apply-button {
    min-width: 80px;
    margin-right: 8px;
    margin-bottom: 4px;
}

/* Keyboard focus (REQ-20 CMD-12 / CMD-28.9). */
.doctrine-apply-button:focus,
.doctrine-dropdown:focus {
    border-width: var(--focus-ring-width);
    border-color: var(--focus-ring);
}
