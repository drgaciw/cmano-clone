/* Doctrine panel — docks bottom-left in the empty lower area of the left drawer (UAT D37),
   clear of the right Unit Detail attack buttons. Width 244px = drawer 260px minus 8px margins. */

@import url("../AegisTokens.uss");

.doctrine-panel {
    position: absolute;
    left: 8px;
    bottom: 8px;
    width: 244px;
    max-height: 470px;
    overflow: hidden;
    flex-direction: column;
    padding: 8px;
    background-color: rgba(12, 18, 28, 0.94);
    border-width: 1px;
    border-color: rgb(50, 65, 80);
    border-radius: 4px;
}

.doctrine-title {
    -unity-font-style: bold;
    color: rgb(200, 210, 220);
    margin-bottom: 4px;
}

.doctrine-inheritance-order {
    color: rgb(140, 155, 170);
    font-size: 11px;
    margin-bottom: 6px;
    white-space: normal;
}

.doctrine-line {
    white-space: normal;
    color: rgb(180, 190, 200);
    margin-bottom: 2px;
}

.doctrine-line--roe {
    -unity-font-style: bold;
}

.doctrine-line--wra {
    color: rgb(170, 185, 200);
}

.doctrine-line--emcon {
    color: rgb(160, 175, 190);
}

.doctrine-line--override {
    color: rgb(240, 180, 80);
}

.doctrine-override-row {
    flex-direction: column;
    align-items: stretch;
    margin-top: 4px;
    margin-bottom: 4px;
}

/* UAT D39: panel inner width is 226px (244 - 2*8 padding - 2*1 border). Unity's default 150px field
   label plus the old 160px min-width pushed the input past the clipped edge. */
.doctrine-dropdown {
    min-width: 0px;
    margin-left: 0px;
    margin-right: 0px;
    margin-bottom: 4px;
}

.doctrine-dropdown > .unity-base-field__label {
    min-width: 88px;
    width: 88px;
}

.doctrine-dropdown > .unity-base-field__input {
    flex-grow: 1;
    min-width: 0px;
}

.doctrine-apply-button {
    min-width: 80px;
    margin-right: 8px;
    margin-bottom: 4px;
}

/* Keyboard focus (REQ-20 CMD-12 / CMD-28.9). */
.doctrine-apply-button:focus,
.doctrine-dropdown:focus {
    border-width: var(--focus-ring-width);
    border-color: var(--focus-ring);
}
