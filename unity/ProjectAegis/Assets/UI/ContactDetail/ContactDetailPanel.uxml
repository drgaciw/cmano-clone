<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="contact-detail-root" class="contact-detail-panel">
        <ui:Label text="CONTACT DETAIL" class="contact-detail-title" />
        <ui:Label name="contact-id-line" text="CONTACT: —" class="contact-detail-line" />
        <ui:Label name="target-id-line" text="TARGET: —" class="contact-detail-line" />
        <ui:Label name="lifecycle-line" text="STATE: —" class="contact-detail-line" />
        <ui:Label name="classification-line" text="CLASS: —" class="contact-detail-line" />
        <ui:Label name="confidence-line" text="CONF: —" class="contact-detail-line" />
        <ui:Label name="provenance-line" text="Detected by: —" class="contact-detail-line" />
        <ui:Label name="wra-line" text="WRA: —" class="contact-detail-line contact-detail-line--wra" />
        <ui:Label name="bda-line" text="BDA: —" class="contact-detail-line contact-detail-line--bda" />
        <ui:Label name="staleness-line" text="— ticks stale" class="contact-detail-line contact-detail-line--stale" />
        <ui:Label name="source-line" text="SOURCE: —" class="contact-detail-line" />
        <ui:Label name="comms-line" text="COMMS: —" class="contact-detail-line contact-detail-line--comms" />
        <ui:Label name="last-known-line" text="LAST KNOWN: —" class="contact-detail-line" />
        <ui:Label name="explain-link-line" text="EXPLAIN: —" class="contact-detail-line contact-detail-line--link" />
    </ui:VisualElement>
</ui:UXML>
