/* Contact detail chrome — belief/inference panel, distinct from own-unit detail (CMD-29). */

.contact-detail-panel {
    position: absolute;
    right: 0;
    top: 56px;
    bottom: 0;
    width: 340px;
    max-width: 45%;
    min-width: 280px;
    flex-direction: column;
    padding: 8px;
    background-color: rgba(18, 14, 22, 0.94);
    border-left-width: 1px;
    border-left-color: rgb(90, 55, 70);
}

.contact-detail-title {
    -unity-font-style: bold;
    color: rgb(220, 180, 190);
    margin-bottom: 6px;
}

.contact-detail-line {
    color: rgb(190, 175, 185);
    margin-bottom: 2px;
    white-space: normal;
    flex-shrink: 0;
}

.contact-detail-scroll { flex-grow: 1; min-height: 0; }
.contact-detail-heading { -unity-font-style: bold; margin-top: 6px; }
.contact-detail-section { margin-top: 8px; color: rgb(220, 210, 215); }
.contact-detail-next {
    margin-top: 8px;
    padding: 6px;
    background-color: rgba(50, 45, 60, 0.9);
    color: rgb(240, 230, 215);
}

.contact-detail-line--stale {
    color: rgb(200, 160, 120);
}
