/* Contact detail chrome — belief/inference panel, distinct from own-unit detail (CMD-29). */

.contact-detail-panel {
    position: absolute;
    right: 0;
    top: 56px;
    bottom: 0;
    width: 340px;
    max-width: 45%;
    min-width: 280px;
    flex-direction: column;
    padding: 8px;
    background-color: rgba(18, 14, 22, 0.94);
    border-left-width: 1px;
    border-left-color: rgb(90, 55, 70);
}

.contact-detail-title {
    -unity-font-style: bold;
    color: rgb(220, 180, 190);
    margin-bottom: 6px;
}

.contact-detail-line {
    color: rgb(190, 175, 185);
    margin-bottom: 2px;
    white-space: normal;
    flex-shrink: 0;
}

.contact-detail-scroll { flex-grow: 1; min-height: 0; }
.contact-detail-heading { -unity-font-style: bold; margin-top: 6px; }
.contact-detail-section { margin-top: 8px; color: rgb(220, 210, 215); }
.contact-detail-next {
    margin-top: 8px;
    padding: 6px;
    background-color: rgba(50, 45, 60, 0.9);
    color: rgb(240, 230, 215);
}

.contact-detail-line--stale {
    color: rgb(200, 160, 120);
}

.contact-detail-declutter {
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    color: rgb(215, 205, 190);
    margin-bottom: 4px;
}

.contact-detail-deep-links {
    flex-direction: column;
    margin-top: 8px;
    margin-bottom: 4px;
}

.contact-detail-deep-link {
    margin-bottom: 4px;
    padding: 4px 6px;
    background-color: rgba(45, 55, 70, 0.95);
    color: rgb(230, 235, 245);
    -unity-text-align: middle-left;
}

.contact-detail-deep-link:disabled {
    color: rgb(130, 125, 135);
    background-color: rgba(35, 32, 40, 0.9);
}

/* Non-color provenance cues — border weight + italic for unknown/denied (DRG-180). */
.contact-provenance-cue--unknown {
    border-left-width: 3px;
    border-left-color: rgb(130, 130, 140);
    padding-left: 6px;
    -unity-font-style: italic;
}

.contact-provenance-cue--nominal {
    border-left-width: 3px;
    border-left-color: rgb(110, 150, 120);
    padding-left: 6px;
}

.contact-provenance-cue--degraded {
    border-left-width: 3px;
    border-left-color: rgb(170, 140, 90);
    padding-left: 6px;
    -unity-font-style: bold;
}

.contact-provenance-cue--denied {
    border-left-width: 3px;
    border-left-color: rgb(170, 100, 100);
    padding-left: 6px;
    -unity-font-style: bold;
}

/* DLZ cue tokens — border weight + italic/bold for unknown/marginal/out (DRG-266). */
.dlz-cue--unknown {
    border-left-width: 3px;
    border-left-color: rgb(130, 130, 140);
    padding-left: 6px;
    -unity-font-style: italic;
}

.dlz-cue--in-zone {
    border-left-width: 3px;
    border-left-color: rgb(110, 150, 120);
    padding-left: 6px;
}

.dlz-cue--approaching {
    border-left-width: 3px;
    border-left-color: rgb(170, 140, 90);
    padding-left: 6px;
    -unity-font-style: bold;
}

.dlz-cue--out-of-zone {
    border-left-width: 3px;
    border-left-color: rgb(170, 100, 100);
    padding-left: 6px;
    -unity-font-style: bold;
}
