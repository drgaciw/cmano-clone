@import url("../AegisTokens.uss");

/* Docked tooling panel (hidden by default in DelegationSmoke showPanel=0). */
.platform-import-panel {
    position: absolute;
    left: 268px;
    top: 64px;
    width: 320px;
    max-height: 70%;
    min-width: 280px;
    flex-direction: column;
    padding: 6px;
    background-color: var(--surface-panel);
    border-width: 1px;
    border-color: var(--border-panel);
    border-radius: 4px;
}

.platform-import-title {
    -unity-font-style: bold;
    color: var(--text-heading);
    margin-bottom: 4px;
}

.platform-import-workbook-path {
    margin-bottom: 4px;
}

.platform-import-actions {
    flex-direction: row;
    margin-bottom: 4px;
}

.platform-import-action-button {
    margin-right: 4px;
    min-width: 72px;
}

.platform-import-approve-button:disabled {
    opacity: var(--diff-pending-opacity);
}

.platform-import-status {
    color: var(--text-muted);
    margin-bottom: 4px;
    white-space: normal;
}

.platform-import-status--blocked {
    color: var(--diff-blocked);
    -unity-font-style: bold;
}

.platform-import-diff-title {
    -unity-font-style: bold;
    color: var(--text-body);
    margin-bottom: 2px;
}

.platform-import-diff-list {
    flex-grow: 1;
    min-height: 100px;
    margin-bottom: 4px;
}

.platform-import-diff-row {
    color: var(--text-body);
}

.platform-import-acknowledge {
    color: var(--diff-pending);
}
