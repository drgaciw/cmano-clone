/* DRG-408 companion map balloon overlay — aligns with MapPlaceholderPanel without blocking map input. */

.map-balloon-overlay {
    position: absolute;
    left: 260px;
    right: 300px;
    top: 56px;
    bottom: 0;
    flex-direction: column;
}

.map-balloon-unanchored-strip {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    padding: 4px 8px;
}

.map-balloon-canvas {
    flex-grow: 1;
    margin: 4px 8px 8px 8px;
    position: relative;
}

.map-balloon-card {
    max-width: 220px;
    margin: 2px 4px;
    padding: 3px 6px;
    border-width: 1px;
    border-radius: 3px;
}

.map-balloon-card-header {
    font-size: 9px;
    -unity-font-style: bold;
}

.map-balloon-card-body {
    font-size: 10px;
    white-space: normal;
}

.map-balloon-card--pause {
    color: rgb(255, 232, 220);
    background-color: rgba(92, 24, 24, 0.92);
    border-color: rgb(245, 95, 85);
    border-left-width: 3px;
}

.map-balloon-card--alert {
    color: rgb(215, 240, 255);
    background-color: rgba(18, 44, 68, 0.90);
    border-color: rgb(90, 180, 240);
    border-left-width: 2px;
}
