/* Left drawer chrome — OOB / Missions / Contacts under the top bar. */

@import url("../AegisTokens.uss");

.c2-drawer-panel {
    position: absolute;
    left: 0;
    top: 56px;
    bottom: 0;
    width: 260px;
    min-width: 240px;
    flex-direction: column;
    padding: 6px 8px;
    background-color: rgba(12, 18, 28, 0.94);
    border-right-width: 1px;
    border-right-color: rgb(50, 65, 80);
}

.c2-drawer-panel--planning-readonly {
    border-color: rgb(70, 82, 96);
    border-width: 1px;
    opacity: 0.88;
}

.c2-drawer-panel--planning-readonly .c2-drawer-tabs {
    opacity: 0.65;
}

.c2-drawer-tabs {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 6px;
    flex-shrink: 0;
}

/* Keep tabs as compact chips (default Toggle stretches full drawer width). */
.c2-drawer-tabs Toggle {
    flex-grow: 0;
    flex-shrink: 0;
    width: auto;
    max-width: 96px;
    margin-right: 4px;
    margin-bottom: 2px;
    color: rgb(180, 190, 200);
    font-size: 11px;
}

.c2-drawer-tabs Toggle > .unity-toggle__input {
    margin-right: 2px;
}

.c2-drawer-list {
    flex-grow: 1;
    min-height: 120px;
}

.c2-drawer-list--hidden {
    display: none;
}

.oob-row {
    padding: 2px 4px;
    color: rgb(180, 190, 200);
}

.oob-row--selected {
    background-color: rgba(74, 158, 255, 0.25);
    border-left-width: 3px;
    border-left-color: rgb(74, 158, 255);
}

/* Keyboard focus (REQ-20 CMD-12 / CMD-28.9) — OOB rows are the primary keyboard
   navigation surface named in REQ-20 ("keyboard focus order for OOB and message log"). */
.oob-row:focus {
    border-left-width: var(--focus-ring-width);
    border-left-color: var(--focus-ring);
}
