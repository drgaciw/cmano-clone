/* Right unit detail chrome — fixed column under the top bar. */

.unit-detail-panel {
    position: absolute;
    right: 0;
    top: 56px;
    bottom: 0;
    width: 300px;
    min-width: 280px;
    flex-direction: column;
    padding: 8px;
    background-color: rgba(12, 18, 28, 0.94);
    border-left-width: 1px;
    border-left-color: rgb(50, 65, 80);
}

.unit-detail-title {
    -unity-font-style: bold;
    color: rgb(200, 210, 220);
    margin-bottom: 6px;
}

.unit-detail-line {
    color: rgb(180, 190, 200);
    margin-bottom: 2px;
}

.unit-detail-attack-menu {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
    margin-bottom: 4px;
}

.unit-detail-attack-btn {
    margin-right: 4px;
    margin-bottom: 4px;
}

.unit-detail-attack-btn:disabled {
    opacity: 0.45;
}

.dlz-cue--unknown {
    border-left-width: 3px;
    border-left-color: rgb(130, 130, 140);
    padding-left: 6px;
    -unity-font-style: italic;
}

.dlz-cue--in-zone {
    border-left-width: 3px;
    border-left-color: rgb(110, 150, 120);
    padding-left: 6px;
}

.dlz-cue--approaching {
    border-left-width: 3px;
    border-left-color: rgb(170, 140, 90);
    padding-left: 6px;
    -unity-font-style: bold;
}

.dlz-cue--out-of-zone {
    border-left-width: 3px;
    border-left-color: rgb(170, 100, 100);
    padding-left: 6px;
    -unity-font-style: bold;
}
