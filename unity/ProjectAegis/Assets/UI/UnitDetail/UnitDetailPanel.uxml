<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="unit-detail-root" class="unit-detail-panel">
        <ui:Label text="UNIT DETAIL" class="unit-detail-title" />
        <ui:Label name="unit-id-line" text="UNIT: —" class="unit-detail-line" />
        <ui:Label name="status-line" text="STATUS: —" class="unit-detail-line" />
        <ui:Label name="unit-control-status" text="CONTROL: —" class="unit-detail-line unit-detail-control-status" />
        <ui:VisualElement name="unit-control-actions" class="unit-detail-control-actions">
            <ui:Button name="unit-take-control" text="Take Control" class="unit-detail-control-btn" />
            <ui:Button name="unit-return-to-agent" text="Return to Agent" class="unit-detail-control-btn" />
            <ui:Button name="unit-pause-agent" text="Pause Agent" class="unit-detail-control-btn" />
            <ui:Button name="unit-resume-agent" text="Resume Agent" class="unit-detail-control-btn" />
        </ui:VisualElement>
        <ui:Label name="unit-control-feedback" text="" class="unit-detail-line unit-detail-control-feedback" />
        <ui:Label name="comms-line" text="COMMS: —" class="unit-detail-line unit-detail-line--comms" />
        <ui:Label name="magazine-line" text="MAGAZINE: —" class="unit-detail-line" />
        <ui:Label name="emcon-line" text="EMCON: —" class="unit-detail-line" />
        <ui:Label name="doctrine-line" text="DOCTRINE: —" class="unit-detail-line" />
        <ui:Label name="fuel-line" text="FUEL: —" class="unit-detail-line" />
        <ui:Label name="dlz-line" text="DLZ: —" class="unit-detail-line dlz-cue--unknown" />
        <ui:Label name="wra-salvo-line" text="WRA SALVO: —" class="unit-detail-line wra-salvo-cue--unknown" />
        <ui:Label name="engage-line" text="ENGAGE: —" class="unit-detail-line" />
        <ui:Label name="attack-options-line" text="ATTACK: —" class="unit-detail-line unit-detail-line--attack attack-option-cue--empty" />
        <ui:VisualElement name="attack-menu" class="unit-detail-attack-menu">
            <ui:VisualElement name="weapon-row-fire-single" class="unit-detail-weapon-row" focusable="true">
                <ui:Button name="attack-fire-single" text="Fire 1 round" class="unit-detail-attack-btn" />
            </ui:VisualElement>
            <ui:VisualElement name="weapon-row-fire-salvo" class="unit-detail-weapon-row" focusable="true">
                <ui:Button name="attack-fire-salvo" text="Fire salvo" class="unit-detail-attack-btn" />
            </ui:VisualElement>
            <ui:Button name="attack-hold-fire" text="Hold fire" class="unit-detail-attack-btn" />
        </ui:VisualElement>
        <ui:Label name="commit-strip-constraints" text="COMMIT: —" class="unit-detail-line commit-strip-cue--empty" />
        <ui:Label name="commit-strip-cost" text="COST: —" class="unit-detail-line commit-strip-cue--empty" />
        <ui:Label name="commit-bark-line" text="" class="unit-detail-line commit-bark-line" />
        <ui:Label name="contact-line" text="CONTACT: —" class="unit-detail-line unit-detail-line--contact" />
    </ui:VisualElement>
</ui:UXML>
