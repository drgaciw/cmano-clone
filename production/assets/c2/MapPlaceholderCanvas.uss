 */

@import url("AegisTokens.uss");

/* Center flex map field — deep surface under map canvas */
.c2-map-field {
    flex-grow: 1;
    flex-direction: column;
    background-color: var(--surface-deep);
    min-width: 0;
    min-height: 0;
}

/* Map placeholder canvas — art bible map surface */
.c2-map-canvas {
    flex-grow: 1;
    background-color: var(--surface-map);
    border-width: 1px;
    border-color: var(--border-subtle);
    position: relative;
}

/* APP-6 symbol host region (atlas-driven at runtime) */
.c2-map-symbol {
    position: absolute;
    width: 16px;
    height: 16px;
    min-width: 16px;
    min-height: 16px;
}

/* Planning mode: dim overlay + reduced symbol opacity */
.c2-map-canvas--planning {
    opacity: 0.85;
}

.c2-map-canvas--planning .c2-map-symbol {
    opacity: 0.42;
}

.c2-map-planning-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(8, 14, 22, 0.35);
}

.c2-map-canvas--planning .c2-map-planning-overlay {
    display: flex;
}

.c2-map-canvas:not(.c2-map-canvas--planning) .c2-map-planning-overlay {
    display: none;
}
