/* C2LeftDrawerPanel.uss — ASSET-007 Left Drawer Panel
 * Status: Done (S113 wave 3)
 * Authority: design/assets/specs/c2-ui-assets.md ASSET-007
 * Imports: AegisTokens.uss semantic tokens
 * Sprint: S113 asset Specced→Done wave 3
 */

@import url("AegisTokens.uss");

/* Root drawer — 240px tabbed OOB / missions / contacts */
.c2-left-drawer {
    flex-direction: column;
    width: 240px;
    min-width: 240px;
    max-width: 240px;
    flex-grow: 1;
    background-color: var(--surface-panel);
    border-right-width: 1px;
    border-right-color: var(--border-subtle);
    padding: var(--space-sm);
}

/* Tab strip */
.c2-left-drawer__tabs {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-sm);
    border-bottom-width: 1px;
    border-bottom-color: var(--border-subtle);
}

.c2-left-drawer__tab {
    flex-grow: 1;
    height: 28px;
    min-height: 28px;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    color: var(--text-muted);
    background-color: transparent;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    padding-left: var(--space-xs);
    padding-right: var(--space-xs);
}

.c2-left-drawer__tab--active {
    color: var(--text-data);
    -unity-font-style: bold;
    border-bottom-color: var(--selected-ring);
}

/* Scrollable list region under tabs */
.c2-left-drawer__list {
    flex-grow: 1;
    flex-direction: column;
    overflow: hidden;
}

.c2-left-drawer__list--hidden {
    display: none;
}

/* OOB tree rows — 20px fixed height */
.c2-left-drawer__oob-row {
    flex-direction: row;
    align-items: center;
    height: 20px;
    min-height: 20px;
    max-height: 20px;
    font-size: 11px;
    color: var(--text-data);
    padding-left: var(--space-xs);
    padding-right: var(--space-xs);
}

.c2-left-drawer__oob-row:focus {
    border-left-width: var(--focus-ring-width);
    border-left-color: var(--focus-ring);
}

/* Mission / contact list rows share OOB row metrics */
.c2-left-drawer__mission-row,
.c2-left-drawer__contact-row {
    flex-direction: row;
    align-items: center;
    height: 20px;
    min-height: 20px;
    max-height: 20px;
    font-size: 11px;
    color: var(--text-data);
    padding-left: var(--space-xs);
    padding-right: var(--space-xs);
}

/* Planning-readonly — mute tabs and borders (#465260 / --border-planning) */
.c2-left-drawer--planning-readonly {
    border-right-color: var(--border-planning);
}

.c2-left-drawer--planning-readonly .c2-left-drawer__tabs {
    border-bottom-color: var(--border-planning);
}

.c2-left-drawer--planning-readonly .c2-left-drawer__tab {
    color: var(--border-planning);
}

.c2-left-drawer--planning-readonly .c2-left-drawer__tab--active {
    color: var(--text-muted);
    border-bottom-color: var(--border-planning);
}

.c2-left-drawer--planning-readonly .c2-left-drawer__oob-row,
.c2-left-drawer--planning-readonly .c2-left-drawer__mission-row,
.c2-left-drawer--planning-readonly .c2-left-drawer__contact-row {
    color: var(--text-muted);
}
