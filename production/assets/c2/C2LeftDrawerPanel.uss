/* C2LeftDrawerPanel.uss — ASSET-007 Left Drawer Panel
 * Status: Done (S113 wave 3 — Specced→Done; not Approved)
 * Authority: design/assets/specs/c2-ui-assets.md ASSET-007
 * Tokens: AegisTokens.uss semantic palette (surface/border/text-data)
 * Unity wire: unity/ProjectAegis/Assets/UI/C2LeftDrawer/C2LeftDrawerPanel.uss
 */

@import url("AegisTokens.uss");

/* 240px drawer width region — panel surface + right edge against map */
.c2-drawer-panel {
    flex-direction: column;
    width: 240px;
    min-width: 240px;
    max-width: 240px;
    flex-grow: 0;
    flex-shrink: 0;
    padding: var(--space-sm);
    background-color: var(--surface-panel);
    border-right-width: 1px;
    border-right-color: var(--border-subtle);
}

/* Tab row: OOB / missions / contacts */
.c2-drawer-tabs {
    flex-direction: row;
    align-items: center;
    height: 24px;
    min-height: 24px;
    margin-bottom: var(--space-sm);
    border-bottom-width: 1px;
    border-bottom-color: var(--border-subtle);
}

.c2-drawer-tab {
    flex-grow: 1;
    height: 22px;
    padding-left: var(--space-xs);
    padding-right: var(--space-xs);
    font-size: 11px;
    color: var(--text-muted);
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0);
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
}

.c2-drawer-tab--active {
    color: var(--text-heading);
    border-bottom-color: var(--selected-ring);
    -unity-font-style: bold;
}

/* Scrollable list region under tabs */
.c2-drawer-list {
    flex-grow: 1;
    flex-direction: column;
    overflow: hidden;
}

/* Inactive tab lists stay out of layout */
.c2-drawer-list--hidden {
    display: none;
}

/* OOB / missions / contacts rows — ~20px, mono-ish data color */
.c2-drawer-row {
    flex-direction: row;
    align-items: center;
    height: 20px;
    min-height: 20px;
    max-height: 20px;
    padding-left: var(--space-xs);
    padding-right: var(--space-xs);
    font-size: 10px;
    color: var(--text-data);
    /* mono-ish data: default UI font (no Resources glyph errors); color carries data role */
}

.c2-drawer-row--selected {
    background-color: var(--selected-row-bg);
    border-left-width: 2px;
    border-left-color: var(--selected-row-bar);
}

.c2-drawer-row--dead {
    color: var(--text-muted);
    opacity: 0.55;
}

.c2-drawer-row:focus {
    border-left-width: var(--focus-ring-width);
    border-left-color: var(--focus-ring);
}

/* Alias used by OobTree presentation StyleClass default */
.oob-row {
    flex-direction: row;
    align-items: center;
    height: 20px;
    min-height: 20px;
    max-height: 20px;
    padding-left: var(--space-xs);
    padding-right: var(--space-xs);
    font-size: 10px;
    color: var(--text-data);
}

/* Planning-readonly: mute tabs/borders with planning border token (#465260) */
.c2-drawer-panel--planning-readonly {
    opacity: 0.85;
    border-right-color: var(--border-planning);
}

.c2-drawer-panel--planning-readonly .c2-drawer-tab {
    color: var(--text-muted);
    opacity: 0.75;
}

.c2-drawer-panel--planning-readonly .c2-drawer-tabs {
    border-bottom-color: var(--border-planning);
}
