/* RightUnitDetailPanel.uss — ASSET-008 Right Unit Detail Panel
 * Status: Done (S113 wave 3 — Specced→Done; not Approved)
 * Authority: design/assets/specs/c2-ui-assets.md ASSET-008
 * Tokens: AegisTokens.uss semantic palette (surface/border/text-data)
 * Unity wire: unity/ProjectAegis/Assets/UI/UnitDetail/UnitDetailPanel.uss
 */

@import url("AegisTokens.uss");

/* ~320px selection readout panel — left edge against map */
.unit-detail-panel {
    flex-direction: column;
    width: 320px;
    min-width: 320px;
    max-width: 320px;
    flex-grow: 0;
    flex-shrink: 0;
    padding: var(--space-sm);
    background-color: var(--surface-panel);
    border-left-width: 1px;
    border-left-color: var(--border-subtle);
}

/* Section headers — sans 12px (no avatar portrait styles) */
.unit-detail-header {
    font-size: 12px;
    color: var(--text-heading);
    -unity-font-style: bold;
    margin-top: var(--space-sm);
    margin-bottom: var(--space-xs);
}

/* Numeric / catalog fields — ~10px mono-ish data color */
.unit-detail-line {
    font-size: 10px;
    color: var(--text-data);
    /* mono-ish data: default UI font (no Resources glyph errors); color carries data role */
    margin-top: 2px;
    margin-bottom: 2px;
    min-height: 14px;
}

.unit-detail-section {
    flex-direction: column;
    margin-bottom: var(--space-sm);
    border-bottom-width: 1px;
    border-bottom-color: var(--border-section);
    padding-bottom: var(--space-xs);
}

.unit-detail-label {
    font-size: 10px;
    color: var(--text-muted);
    margin-right: var(--space-xs);
}

.unit-detail-value {
    font-size: 10px;
    color: var(--text-data);
}

/* Empty / no-selection muted state */
.unit-detail-panel--empty {
    opacity: 0.72;
}

.unit-detail-panel--empty .unit-detail-line {
    color: var(--text-muted);
}

.unit-detail-empty-hint {
    font-size: 11px;
    color: var(--text-muted);
    -unity-font-style: italic;
    margin-top: var(--space-md);
}
