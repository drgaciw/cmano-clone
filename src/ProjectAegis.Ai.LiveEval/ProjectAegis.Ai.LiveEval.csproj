<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <!-- C# 12 pin. Do not raise. See Directory.Build.props. -->
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ProjectAegis.Ai.LiveEval</RootNamespace>
    <Description>
      On-demand AAR live-evaluation lane (DRG-745). NOT in ProjectAegis.sln / CI.
      Fake path is default. Paid provider SDKs and Evaluation judge packages are NOT pinned until owner budget approval.
    </Description>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProjectAegis.Ai.Host\ProjectAegis.Ai.Host.csproj" />
    <ProjectReference Include="..\ProjectAegis.Ai.Contracts\ProjectAegis.Ai.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\tests\ai-fixtures\**\*"
             Link="ai-fixtures\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
