<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <!-- C# 12 pin. Do not raise. See Directory.Build.props. -->
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>ProjectAegis.MissionEditor.Cli.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProjectAegis.MissionEditor.Cli\ProjectAegis.MissionEditor.Cli.csproj" />
    <ProjectReference Include="..\ProjectAegis.Data\ProjectAegis.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\assets\data\scenarios\validation\**\*" Link="assets\data\scenarios\validation\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tests\ai-fixtures\authoring\**\*" Link="ai-fixtures\authoring\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
