{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Dublin",
  "schedule": [
    "before 9am on monday"
  ],
  "packageRules": [
    {
      "description": "One weekly PR for all minor and patch bumps",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "weekly minor and patch updates",
      "groupSlug": "weekly-minor-patch"
    },
    {
      "description": "Major bumps off for now; security fixes still come through vulnerabilityAlerts",
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Unity Editor bump stays owner-only: keep out of the weekly group (must move together with unity-ci.yml unityVersion and tools/unity defaults; currently 6000.3.27f2)",
      "matchFileNames": [
        "unity/ProjectAegis/ProjectSettings/ProjectVersion.txt"
      ],
      "groupName": null,
      "enabled": false
    },
    {
      "description": "Workflow python-version stays owner-only: keep out of the weekly group",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "python"
      ],
      "groupName": null,
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [
      "at any time"
    ],
    "labels": [
      "security"
    ]
  },
  "osvVulnerabilityAlerts": true
}
